# Copy this file to .env and fill in your values. Never commit .env to Git.

# n8n webhook base URL (default for local self-hosted n8n)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/aeroturn

# FastAPI backend base URL
API_BASE_URL=http://localhost:8000

# Cloud LLM credentials (optional — Ollama works offline without these)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
